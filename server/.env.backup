# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=price_comparison

# CORS - comma separated allowed origins
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Always uses live Amazon/Flipkart scraping
ADAPTER_MODE=live

# Amazon India - official/affiliate API credentials (optional)
AMAZON_PA_API_ACCESS_KEY=
AMAZON_PA_API_SECRET_KEY=
AMAZON_PA_API_PARTNER_TAG=
AMAZON_PA_API_HOST=webservices.amazon.in
AMAZON_PA_API_REGION=in

# Flipkart Affiliate API credentials (optional)
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
FLIPKART_API_BASE=https://affiliate-api.flipkart.net/affiliate

# Demo provider seed toggle
SEED_DEMO_DATA=false
