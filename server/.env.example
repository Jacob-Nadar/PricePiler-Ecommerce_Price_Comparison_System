# ─────────────────────────────────────────────────────────────────────
# PricePiler server settings. Copy to server/.env and fill in your values:
#   cp .env.example .env        (Windows: copy .env.example .env)
# Never commit server/.env — it holds passwords.
# ─────────────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development
# Comma-separated origins allowed to call the API (the Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173
# Public URL of the website, used for links inside emails
APP_URL=http://localhost:5173
REQUEST_TIMEOUT_MS=8000

# ── MySQL ────────────────────────────────────────────────────────────
# MySQL 8 or MariaDB 10.4+ (XAMPP works). The database is created automatically.
# Using the included docker-compose.yml? Then use DB_PORT=3307 and DB_PASSWORD=pricepiler.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=price_comparison
# Apply pending migrations automatically when the server starts
DB_AUTO_MIGRATE=true

# ── Auth & sessions ──────────────────────────────────────────────────
# Long random string used to hash OTP codes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=
SESSION_TTL_DAYS=7
# true when the site is served over HTTPS (always in production)
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
OTP_TTL_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
MAX_FAILED_LOGINS=5
LOGIN_LOCKOUT_MINUTES=15
# Restrict sign-ups to some domains, e.g. gmail.com (empty = any email address)
ALLOWED_EMAIL_DOMAINS=

# ── Email (Gmail SMTP) ───────────────────────────────────────────────
# Use a Gmail *App Password*, not your normal password:
#   Google Account → Security → 2-Step Verification (turn on) → App passwords
# Leave SMTP_USER/SMTP_PASS empty in development to print emails (and OTP codes)
# to the server console instead of sending them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PricePiler <your.address@gmail.com>

# ── Background price & stock monitoring ──────────────────────────────
MONITOR_ENABLED=true
# How often the scheduler looks for due listings (cron syntax)
MONITOR_CRON=*/15 * * * *
# How often each tracked listing is re-checked
MONITOR_INTERVAL_MINUTES=360
MONITOR_BATCH_SIZE=20
MONITOR_CONCURRENCY=2
# Pause between two requests to the same store
MONITOR_REQUEST_DELAY_MS=4000
MONITOR_MAX_RETRIES=2
MONITOR_RETRY_BASE_DELAY_MS=2000
MONITOR_MAX_BACKOFF_MINUTES=1440
# Unchanged prices are still recorded at most this often
SNAPSHOT_HEARTBEAT_HOURS=24

# ── Scraping ─────────────────────────────────────────────────────────
# Optional fixed HTTP/HTTPS proxy you are authorised to use (no rotation)
SCRAPER_PROXY_URL=
SCRAPER_DEBUG=false
SCRAPER_MAX_PAGES=4
# Fallback price-history file used only when MySQL is not connected
# PRICE_HISTORY_FILE=./data/price-history.json
