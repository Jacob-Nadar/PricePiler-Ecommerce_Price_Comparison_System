{
  "name": "pricepiler",
  "private": true,
  "description": "PricePiler — live price comparison for Amazon India, Flipkart and Myntra",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "migrate": "npm run migrate --prefix server",
    "test": "npm test --prefix server",
    "build": "npm run build --prefix client",
    "start": "npm run build && npm start --prefix server",
    "admin:create": "npm run admin:create --prefix server --"
  }
}
